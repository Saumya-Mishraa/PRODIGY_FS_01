PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=your_mongodb_connection_string

# Long random string used to sign JWTs
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# Frontend origin, used for CORS + Socket.IO
CLIENT_URL=http://localhost:5173

# This server's own public URL (no trailing slash). Only used to build
# absolute attachment URLs when USE_CLOUDINARY=false (local-disk mode).
# Safe to leave unset for local dev — it's derived from the incoming
# request automatically. In production, setting it explicitly is a good
# idea, but the bigger recommendation is: don't run USE_CLOUDINARY=false
# in production at all (see below).
# SERVER_URL=https://your-backend.onrender.com

# Optional: enable Cloudinary instead of local disk storage for uploads.
# STRONGLY RECOMMENDED (effectively required) in production on Render —
# its filesystem is ephemeral, so anything written to local disk is lost
# on every restart/redeploy.
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
